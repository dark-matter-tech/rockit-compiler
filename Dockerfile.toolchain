FROM ubuntu:22.04

LABEL org.opencontainers.image.title="Rockit Compiler"
LABEL org.opencontainers.image.description="Pre-built Rockit compiler (Stage 1)"
LABEL org.opencontainers.image.vendor="Dark Matter Tech"

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        clang-15 lld llvm-dev libssl-dev pkg-config git curl ca-certificates && \
    ln -sf /usr/bin/clang-15 /usr/bin/clang && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY rockit-compiler/bin/rockit /usr/local/bin/rockit

RUN chmod +x /usr/local/bin/rockit && rockit version

ENV ROCKIT=/usr/local/bin/rockit

WORKDIR /workspace
